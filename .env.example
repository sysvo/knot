# Copy to .env and edit. Everything here has a working default except
# KNOT_PUBLIC_URL, which must match the address readers actually use.

# The public address of your forum, without a trailing slash.
# OAuth callbacks and magic links are built from this, so getting it wrong means
# sign-in links point at the wrong host.
KNOT_PUBLIC_URL=https://forum.example.com

# The hostname Caddy serves and obtains a certificate for.
# Use "localhost" to try the stack without DNS (the browser will warn about the
# self-signed certificate).
KNOT_DOMAIN=forum.example.com

# Creates the first administrator on an empty database. Ignored afterwards.
# Optional: if you leave these unset, the first visit shows a setup page that
# asks for the same details in the browser.
# You can also promote an existing account with `docker compose exec api knot role alice admin`.
KNOT_ADMIN_USERNAME=admin
KNOT_ADMIN_EMAIL=you@example.com
KNOT_ADMIN_PASSWORD=change-this-to-something-long

# ---- optional ----

# Log verbosity: debug | info | warn | error
KNOT_LOG_LEVEL=info
# Structured JSON logs, useful when shipping logs somewhere.
# KNOT_LOG_JSON=true

# Session lifetime (Go duration syntax).
# KNOT_SESSION_TTL=720h

# Minimum password length is enforced at 10; uploads default to 8 MB.
# KNOT_MAX_UPLOAD_MB=8

# Trust X-Forwarded-For from the proxy in front. On by default in the compose
# stack, where Caddy is the only route to the API. Turn it off if you ever publish
# the API port directly: the header is otherwise whatever the caller sends, and it
# decides the rate-limit bucket and the address recorded in the logs.
# KNOT_TRUST_PROXY=false

# Allow profile pictures hosted somewhere else. Off by default: a remote avatar
# makes every reader's browser request an image from that host, which reveals who
# is reading what. Uploads always work.
# KNOT_ALLOW_REMOTE_AVATARS=false

# Backups. A zip holding the database, every upload and a manifest is written
# once a day; the newest N are kept and older ones deleted. The directory defaults
# to a "backups" folder beside the database. Set KNOT_BACKUP_KEEP=0 to schedule
# none at all and take them yourself. Either way, copy them off the machine: they
# live on the same volume as the data they protect.
# KNOT_BACKUP_DIR=/data/backups
# KNOT_BACKUP_KEEP=7

# Outgoing mail. These only seed a fresh install: once you save a host in
# Administration -> Settings -> E-mail, that wins, and you can change the relay
# there and send a test message without touching this file or restarting.
# Without a host, mail is queued and never sent; magic links and password resets
# are unavailable and the login page stops offering them.
# KNOT_SMTP_HOST=smtp.example.com
# KNOT_SMTP_PORT=587
# KNOT_SMTP_USER=apikey
# KNOT_SMTP_PASS=secret
# KNOT_SMTP_FROM=forum@example.com

# Social sign-in. Each provider is enabled only when both values are set.
# Callback URL for GitHub:  https://your-host/api/v1/auth/oauth/github/callback
# Callback URL for Discord: https://your-host/api/v1/auth/oauth/discord/callback
# KNOT_GITHUB_CLIENT_ID=
# KNOT_GITHUB_CLIENT_SECRET=
# KNOT_DISCORD_CLIENT_ID=
# KNOT_DISCORD_CLIENT_SECRET=
