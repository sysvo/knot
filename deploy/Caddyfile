# Caddy fronts both applications and terminates TLS.
#
# KNOT_DOMAIN controls the certificate: a real domain gets one from Let's Encrypt
# automatically, and "localhost" uses Caddy's internal CA (browser warning
# expected). Set it in .env.

{$KNOT_DOMAIN:localhost} {
	encode zstd gzip

	# The API and uploaded files never go through the Next.js server.
	@backend path /api/* /uploads/*
	handle @backend {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		# The API sets its own conservative headers; these cover the HTML app.
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		format console
	}
}
